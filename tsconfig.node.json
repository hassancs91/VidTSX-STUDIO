{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"]
    }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/logging/**/*", "src/license/**/*", "src/updater/**/*", "src/renderer/types/electron.d.ts", "electron.vite.config.*"]
}
