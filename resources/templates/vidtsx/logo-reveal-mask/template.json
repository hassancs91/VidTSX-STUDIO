{
  "formatVersion": 1,
  "id": "vidtsx/logo-reveal-mask",
  "name": "Logo Reveal",
  "version": "1.0.0",
  "description": "A four-second logo opener. Your logo is revealed through a mask — a circle, a wipe, blinds or a diagonal — with an accent edge, the wordmark slides out beside it and the tagline settles between two rules.",
  "author": { "name": "VidTSX", "url": "https://vidtsx.com" },
  "license": "Free to use in your own videos, commercial or not. Do not resell or redistribute the template itself.",
  "minAppVersion": "1.1.0",
  "category": "openers",
  "tags": ["logo", "reveal", "intro", "brand", "opener"],
  "entry": "composition.tsx",
  "thumbnail": "thumb.jpg",
  "formats": {
    "prop": "format",
    "default": "landscape",
    "options": [
      { "value": "landscape", "label": "16:9", "width": 1920, "height": 1080 },
      { "value": "portrait", "label": "9:16", "width": 1080, "height": 1920 },
      { "value": "square", "label": "1:1", "width": 1080, "height": 1080 }
    ]
  },
  "controls": [
    {
      "key": "logo",
      "label": "Logo",
      "type": "image",
      "default": "",
      "group": "Brand",
      "help": "Square works best. Empty draws a monogram."
    },
    {
      "key": "brandName",
      "label": "Brand name",
      "type": "text",
      "default": "VidTSX",
      "group": "Brand",
      "maxLength": 24
    },
    {
      "key": "tagline",
      "label": "Tagline",
      "type": "text",
      "default": "Video, in TSX",
      "group": "Brand",
      "maxLength": 40
    },
    {
      "key": "showTagline",
      "label": "Show the tagline",
      "type": "boolean",
      "default": true,
      "group": "Brand"
    },
    {
      "key": "maskShape",
      "label": "Reveal",
      "type": "select",
      "default": "circle",
      "group": "Reveal",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "wipe", "label": "Wipe" },
        { "value": "blinds", "label": "Blinds" },
        { "value": "diagonal", "label": "Diagonal" }
      ]
    },
    {
      "key": "accentColor",
      "label": "Accent colour",
      "type": "color",
      "default": "#7C5CFF",
      "group": "Style",
      "help": "The hairline, the mask edge, the monogram tile and the tagline rules."
    },
    {
      "key": "bgColor",
      "label": "Background",
      "type": "color",
      "default": "#0B0B12",
      "group": "Style"
    },
    {
      "key": "textColor",
      "label": "Text colour",
      "type": "color",
      "default": "#FFFFFF",
      "group": "Style"
    },
    {
      "key": "bgImage",
      "label": "Background image",
      "type": "image",
      "default": "",
      "group": "Style",
      "help": "Empty draws a soft gradient field."
    }
  ],
  "presets": [
    { "id": "violet", "name": "Violet", "values": { "accentColor": "#7C5CFF", "bgColor": "#0B0B12", "textColor": "#FFFFFF", "bgImage": "" } },
    { "id": "violet-field", "name": "Violet Field", "values": { "accentColor": "#7C5CFF", "bgColor": "#0B0B12", "textColor": "#FFFFFF", "bgImage": "assets/field.jpg" } },
    { "id": "ember", "name": "Ember", "values": { "accentColor": "#F97316", "bgColor": "#0F0A07", "textColor": "#FFFFFF", "bgImage": "" } },
    { "id": "mono", "name": "Mono", "values": { "accentColor": "#FFFFFF", "bgColor": "#0A0A0A", "textColor": "#FFFFFF", "bgImage": "" } },
    { "id": "daylight", "name": "Daylight", "values": { "accentColor": "#7C5CFF", "bgColor": "#F7F7FA", "textColor": "#0B0B12", "bgImage": "" } }
  ]
}
