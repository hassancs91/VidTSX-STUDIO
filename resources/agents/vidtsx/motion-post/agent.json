    "job",
    "video",
    "image-set"
  ],
  "interactions": [
    "form",
    "pick",
    "approve"
  ],
  "starter": {
    "entry": "goal",
    "nodes": {
      "goal": {
        "question": "What kind of post?",
        "select": "one",
        "options": [
          {
            "id": "promo",
            "label": "Promote a product or offer",
            "next": "platform"
          },
          {
            "id": "tip",
            "label": "Share a tip or insight",
            "next": "platform"
          },
          {
            "id": "quote",
            "label": "A quote card",
            "next": "platform"
          },
          {
            "id": "announcement",
            "label": "Announce something",
            "next": "platform"
          }
        ],
        "allowOther": true,
        "otherNext": "platform"
      },
      "platform": {
        "question": "Where will it be posted?",
        "hint": "This sets the frame size.",
        "select": "one",
        "options": [
          {
            "id": "9:16",
            "label": "Reels / Shorts / TikTok",
            "next": "brief"
          },
          {
            "id": "1:1",
            "label": "Instagram feed",
            "next": "brief"
          },
          {
            "id": "16:9",
            "label": "YouTube / X",
            "next": "brief"
          }
        ]
      },
      "brief": {
        "question": "What is it about?",
        "hint": "A sentence is enough — the product, the tip, the words you want on screen.",
        "text": true,
        "multiline": true,
        "next": "$end"
      }
    },
    "opening": "Make an animated post.\n\nPlatform: {{platform}}\nKind: {{goal}}\nAbout: {{brief}}",
    "quickStarts": [
      "A 6s hook for a newsletter launch",
      "Three-tip loop on staying focused",
      "Quote card: \"Done is better than perfect\""
    ]
  },
  "defaults": {
    "maxTurns": 24,
    "effort": "medium"
  },
  "memory": {
    "propose": true
  },
