# VidTSX Studio — development feature toggles
#
# Copy the lines you need into `.env` (gitignored) and set them to 1.
# All flags default OFF in every build, including dev.
#
# These are renderer-side flags: Vite bakes VITE_* values into the renderer
# bundle at BUILD TIME. Release builds must be produced with none of these set
# (a clean checkout has no .env, so CI is safe by default).

# Tools hub screen (AI chat, frame extractor, thumbnail tools, AI testers, …)
VITE_FF_TOOLS=0

# Flows sidebar tab + flow editor
VITE_FF_FLOWS=0

# Videos sidebar tab (Video Studio)
VITE_FF_VIDEO_STUDIO=0

# AI page — local model sub-tabs
VITE_FF_AI_VIDEO=0
VITE_FF_AI_LLM=0
VITE_FF_AI_3D=0
# 3D Studio screen (image -> 3D on the AI runtime; docs/ai-runtime-implementation-plan.md Stage 4)
VITE_FF_THREED_STUDIO=0
VITE_FF_AI_EMBEDDINGS=0

# Sherpa voice-engine section inside the AI page Audio tab
VITE_FF_AI_AUDIO_ENGINE=0

# AI page System tab — Python panel, PyTorch Runtime row, Embedding Engine card
# (hidden until a shipped feature actually consumes those runtimes)
VITE_FF_AI_SYSTEM_RUNTIMES=0

# Custom OpenAI/Anthropic-compatible endpoint form in AI > Providers (H5)
VITE_FF_CUSTOM_PROVIDER=0

# Restore the V1-hidden provider presets (openai, gemini) in the add-provider
# menu. Read by the MAIN process (llm-handlers), not the renderer. (H4)
VITE_FF_ALL_PROVIDERS=0

# Crash-reporting endpoint (main process). Leave unset to compile crash
# reporting out entirely — only official release builds set a real DSN.
# Even with a DSN, nothing is sent unless the user opts in via Settings > Privacy.
# VITE_SENTRY_DSN=
