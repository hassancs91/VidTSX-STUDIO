{
  "name": "vidtsx-studio",
  "productName": "VidTSX Studio",
  "version": "1.0.0",
  "description": "Desktop video composition editor powered by Remotion — render TSX scenes to MP4 locally.",
  "main": "out/main/index.js",
  "author": {
    "name": "LearnWithHasan",
    "email": "hassan.cs91@gmail.com"
  },
  "license": "FSL-1.1-MIT",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "npm run build:vendor && node scripts/dev.js",
    "build": "npm run build:vendor && electron-vite build",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:win": "npm run build:vendor && electron-vite build && electron-builder --win",
    "publish:win": "npm run build && electron-builder --win --publish always",
    "build:mac": "npm run build:vendor && electron-vite build && electron-builder --mac",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "cross-env CHECK_LINKS=1 vitest run model-registry.links",
    "check:types": "node scripts/check-types.mjs"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
