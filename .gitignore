# Stale tsc emit — source of truth lives in .ts/.tsx.
# A `tsc` run with emit dropped 391 .js + .d.ts files into src/ and broke Vite resolution.
src/**/*.js
src/**/*.d.ts
# Keep intentional ambient declarations:
!src/renderer/types/*.d.ts
