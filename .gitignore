# Dependencies
node_modules/

# Build outputs
out/
dist/
release/
build/
*.dmg
*.exe

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Generated by scripts/publish-to-r2.mjs
scripts/.aws-r2-config

# App render/temp workspace
.vidtsx-temp/

# Personal planning doc, not part of repo history
ROADMAP.md

# TypeScript
*.tsbuildinfo

# Stale tsc emit — source of truth lives in .ts/.tsx.
# A `tsc` run with emit dropped 391 .js + .d.ts files into src/ and broke Vite resolution.
src/**/*.js
src/**/*.d.ts
# Keep intentional ambient declarations:
!src/renderer/types/*.d.ts
!src/shared/env.d.ts

# Personal scratch notes (kept local only)
notes
proto-notes

# Raw source footage used for the E2E pipeline tests — 15 GB of camera files,
# local-only. Reports built from it are committed; the footage never is.
raw/

# Python bytecode from the bundled pipelines (TripoSR, rembg, …)
__pycache__/
*.pyc

# Claude Code session lock — per-machine, recreated on each run.
.claude/scheduled_tasks.lock

# External binaries (ffmpeg, whisper.cpp, sd-cli, …) are downloaded on first
# use and never committed (CLAUDE.md). Only the placeholder is tracked.
resources/binaries/*
!resources/binaries/.gitkeep

# Personal notes and per-machine Claude overrides: never on GitHub (go-live D5, 2026-09-30)
my_notes.md
.claude/settings.local.json

# A/B test reports rendered from the raw footage (frames of it are embedded): local only
/*-report.html
